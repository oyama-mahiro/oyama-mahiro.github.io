---
interface Props {
	password: string;
}

const { password } = Astro.props;
---
<post-password-gate
	data-storage-key="fuwari:unlocked:protected-post"
	data-password={password}
	class="card-base z-10 px-6 md:px-9 py-10 relative w-full"
>
	<div class="mx-auto flex max-w-md flex-col items-center text-center">
		<div class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-[var(--primary)]/10 text-3xl text-[var(--primary)]">
			<span aria-hidden="true">🔒</span>
		</div>
		<h1 class="mb-3 text-2xl font-bold text-black/90 dark:text-white/90">这篇文章需要密码</h1>
		<p class="mb-6 text-sm leading-6 text-black/60 dark:text-white/60">
			请输入访问密码后查看文章。
		</p>
		<form class="flex w-full flex-col gap-3" data-password-form>
			<label class="sr-only" for="protected-post-password">访问密码</label>
			<input
				id="protected-post-password"
				name="password"
				type="password"
				autocomplete="current-password"
				placeholder="请输入密码"
				class="h-11 w-full rounded-xl border border-black/10 bg-black/[0.03] px-4 text-black/90 outline-none transition focus:border-[var(--primary)] focus:ring-2 focus:ring-[var(--primary)]/20 dark:border-white/15 dark:bg-white/[0.06] dark:text-white/90"
			/>
			<button
				type="submit"
				class="h-11 rounded-xl bg-[var(--primary)] px-5 font-medium text-white transition hover:brightness-110 active:scale-[0.98]"
			>
				查看文章
			</button>
			<p class="hidden text-sm text-red-500" data-password-error aria-live="polite">
				密码不正确，请重新输入。
			</p>
		</form>
	</div>
</post-password-gate>

<script>
	class PostPasswordGate extends HTMLElement {
		connectedCallback() {
			if (this.dataset.initialized === "true") return;
			this.dataset.initialized = "true";

			const storageKey = this.dataset.storageKey || "fuwari:unlocked:protected-post";
			const accessPassword = this.dataset.password || "";
			const content = document.querySelector<HTMLElement>("#post-container");
			const form = this.querySelector<HTMLFormElement>("[data-password-form]");
			const input = this.querySelector<HTMLInputElement>('input[name="password"]');
			const error = this.querySelector<HTMLElement>("[data-password-error]");
			if (!content || !form || !input || !error) return;

			const unlock = () => {
				content.hidden = false;
				this.hidden = true;
				window.dispatchEvent(new Event("resize"));
			};

			if (sessionStorage.getItem(storageKey) === accessPassword) {
				unlock();
				return;
			}

			requestAnimationFrame(() => input.focus());
			form.addEventListener("submit", (event) => {
				event.preventDefault();
				if (input.value === accessPassword) {
					sessionStorage.setItem(storageKey, accessPassword);
					error.hidden = true;
					unlock();
					return;
				}
				error.hidden = false;
				input.value = "";
				input.focus();
			});
		}
	}

	if (!customElements.get("post-password-gate")) {
		customElements.define("post-password-gate", PostPasswordGate);
	}
</script>
